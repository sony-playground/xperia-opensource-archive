#--------------------------------------------------------------------------
# Common vars
#--------------------------------------------------------------------------
vars:
    vrm_en_offset = 0x4
    vrm_vol_offset = 0x0
    disable = 0
    enable = 1

module: { name = RPMH_PDC_DEBUG_DEBUG_PDC, group = PDC_TCS, import = [arc_export]}
regs:
# Sleep Set TCS 0 (not used in seq)

# Sleep set TCS 1
    TCSt_CMDn_ADDR[1, 0] = 0 : { cmd_db_addr("cx.lvl") }
    TCSt_CMDn_DATA[1, 0] = CX_HLVL_RET
    TCSt_CMDn_MSGID[1, 0] = {0, 1} # {fnf, write}

    TCSt_CMDn_ADDR[1, 1] = 0 : { cmd_db_addr("mx.lvl") }
    TCSt_CMDn_DATA[1, 1] = MX_HLVL_RET 
    TCSt_CMDn_MSGID[1, 1] = {0, 1} # {fnf, write}

    TCSt_CMDn_ADDR[1, 2] = 0 : { cmd_db_addr("xo.lvl") }
    TCSt_CMDn_DATA[1, 2] = XO_HLVL_PMIC_OFF
    TCSt_CMDn_MSGID[1, 2] = {0, 1} # {fnf, write}
    
    TCSt_CMDn_ADDR[1, 3] = 0 : { cmd_db_addr("vrm.soc", vrm_vol_offset) }
    TCSt_CMDn_DATA[1, 3] = disable
    TCSt_CMDn_MSGID[1, 3] = {0, 1} # {rr, write}
    
    # Wait for completion mask
    TCSt_CMD_WAIT_FOR_CMPL_BANK[1] = 0x0 #dont serialize

    # Command Enable Mask
    TCSt_CMD_ENABLE[1] = 0xF

# Wake set TCS 3 #Note: pdc tcs contents sheet might show this as TCS2
    TCSt_CMDn_ADDR[3, 0] = 0 : { cmd_db_addr("cx.lvl") }
    TCSt_CMDn_DATA[3, 0] = CX_MOL_HLVL 
    TCSt_CMDn_MSGID[3, 0] = {1, 1} # {rr, write}

    TCSt_CMDn_ADDR[3, 1] = 0 : { cmd_db_addr("mx.lvl") }
    TCSt_CMDn_DATA[3, 1] = MX_MOL_HLVL 
    TCSt_CMDn_MSGID[3, 1] = {1, 1} # {rr, write}

    TCSt_CMDn_ADDR[3, 2] = 0 : { cmd_db_addr("xo.lvl") }
    TCSt_CMDn_DATA[3, 2] = XO_HLVL_ON
    TCSt_CMDn_MSGID[3, 2] = {1, 1} # {rr, write}
    
    TCSt_CMDn_ADDR[3, 3] = 0 : { cmd_db_addr("vrm.soc", vrm_vol_offset) }
    TCSt_CMDn_DATA[3, 3] = enable
    TCSt_CMDn_MSGID[3, 3] = {1, 1} # {rr, write}
    
    # Wait for completion mask
    TCSt_CMD_WAIT_FOR_CMPL_BANK[3] = 0x0 #dont serialize

    # Command Enable Mask
    TCSt_CMD_ENABLE[3] = 0xF
