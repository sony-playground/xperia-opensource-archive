module : { name = RPMH_PDC_GPU_GPU_PDC, group = PDC_SEQ }
regs:
    SEQ_MEM_m = [
	#CX_MIN_AOSS:
	  0xffbfa1e1,  #0x000: 0xe1   WAIT1     rx_fifo_empty
				   #0x001: 0xa1   SET1      pdc_mode_control
				   #0x002: 0xbf   SET1      seq_tcs_0_start
				   #0x003: 0xff   WAIT1     tcs_0_seq_cmp
	  0xe0a5a4a2,  #0x004: 0xa2   SET1      soc_sleep_req
				   #0x005: 0xa4   SET1      dbg_resource_rel_req
				   #0x006: 0xa5   SET1      wfi_profiling_unit_3
				   #0x007: 0xe0   WAIT1     sequence_resume
	  0x84e28285,  #0x008: 0x85   SET0      wfi_profiling_unit_3
				   #0x009: 0x82   SET0      soc_sleep_req
				   #0x00a: 0xe2   WAIT1     soc_sleep_unlock
				   #0x00b: 0x84   SET0      dbg_resource_rel_req
	  0x2081fcbc   #0x00c: 0xbc   SET1      seq_tcs_3_start
				   #0x00d: 0xfc   WAIT1     tcs_3_seq_cmp
				   #0x00e: 0x81   SET0      pdc_mode_control
				   #0x00f: 0x20   RETURN
                   #0x013: 0x00    
    ]
