module : { name = RPMH_PDC_WLAN_RF_WLAN_RF_PDC, group = PDC_SEQ }
regs:
    SEQ_MEM_m = [
  0xe2a5a2a1,  #0x000: 0xa1   SET1      pdc_mode_control
                #0x001: 0xa2      SET1      soc_sleep_req
                #0x002: 0xa5      SET1      wfi_profiling_unit_3
                #0x003: 0xe2      WAIT1     soc_sleep_unlock
  0xbafbbba6,  #0x004: 0xa6   SET1      generic_profiling_unit_5
               #0x005: 0xbb   SET1      seq_tcs_4_start
               #0x006: 0xfb   WAIT1     tcs_4_seq_cmp
               #0x007: 0xba   SET1      seq_tcs_5_start
  0xb8f9b9fa,  #0x008: 0xfa   WAIT1     tcs_5_seq_cmp
               #0x009: 0xb9   SET1      seq_tcs_6_start
               #0x00a: 0xf9   WAIT1     tcs_6_seq_cmp
               #0x00b: 0xb8   SET1      seq_tcs_7_start
  0x8aaa82f8,  #0x00c: 0xf8   WAIT1     tcs_7_seq_cmp
               #0x00d: 0x82   SET0      soc_sleep_req
               #0x00e: 0xaa   SET1      addl_seq_pwr_ctrl_0_clr_sw_ctrl_pos_edge_detect_intr
               #0x00f: 0x8a   SET0      addl_seq_pwr_ctrl_0_clr_sw_ctrl_pos_edge_detect_intr
  0xa5a2e085,  #0x010: 0x85   SET0      wfi_profiling_unit_3
               #0x011: 0xe0   WAIT1     sequence_resume
               #0x012: 0xa2   SET1      soc_sleep_req
               #0x013: 0xa5   SET1      wfi_profiling_unit_3
  0xbeffbfe2,  #0x014: 0xe2   WAIT1     soc_sleep_unlock
               #0x015: 0xbf   SET1      seq_tcs_0_start
               #0x016: 0xff   WAIT1     tcs_0_seq_cmp
               #0x017: 0xbe   SET1      seq_tcs_1_start
  0xbcfdbdfe,  #0x018: 0xfe   WAIT1     tcs_1_seq_cmp
               #0x019: 0xbd   SET1      seq_tcs_2_start
               #0x01a: 0xfd   WAIT1     tcs_2_seq_cmp
               #0x01b: 0xbc   SET1      seq_tcs_3_start
  0x8bab82fc,  #0x01c: 0xfc   WAIT1     tcs_3_seq_cmp
               #0x01d: 0x82   SET0      soc_sleep_req
               #0x01e: 0xab   SET1      addl_seq_pwr_ctrl_1_clr_sw_ctrl_neg_edge_detect_intr
               #0x01f: 0x8b   SET0      addl_seq_pwr_ctrl_1_clr_sw_ctrl_neg_edge_detect_intr
  0x00000020   #0x020: 0x20   RETURN
               #0x021: 0x00
               #0x022: 0x00
               #0x023: 0x00  

    ]

