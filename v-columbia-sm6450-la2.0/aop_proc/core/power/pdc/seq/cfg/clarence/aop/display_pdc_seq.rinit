#--------------------------------------------------------------------------
# Common vars
#--------------------------------------------------------------------------
vars:

module: { name = RPMH_PDC_DISPLAY_DISPLAY_PDC, group = PDC_SEQ}
    
regs:
    
  SEQ_MEM = [
  #CX_MIN_AOSS:
  0xbf80a1e1,  #0x000: 0xe1   WAIT1     rx_fifo_empty
               #0x001: 0xa1   SET1      pdc_mode_control
               #0x002: 0x80   SET0      timer_match_valid
               #0x003: 0xbf   SET1      seq_tcs_0_start
  0xa5a4a2ff,  #0x004: 0xff   WAIT1     tcs_0_seq_cmp
               #0x005: 0xa2   SET1      soc_sleep_req
               #0x006: 0xa4   SET1      dbg_resource_rel_req
               #0x007: 0xa5   SET1      wfi_profiling_unit_3
  0xe28285e0,  #0x008: 0xe0   WAIT1     sequence_resume
               #0x009: 0x85   SET0      wfi_profiling_unit_3
               #0x00a: 0x82   SET0      soc_sleep_req
               #0x00b: 0xe2   WAIT1     soc_sleep_unlock
  0x80fdbd84,  #0x00c: 0x84   SET0      dbg_resource_rel_req
               #0x00d: 0xbd   SET1      seq_tcs_2_start
               #0x00e: 0xfd   WAIT1     tcs_2_seq_cmp
               #0x00f: 0x80   SET0      timer_match_valid
  0x00002081   #0x010: 0x81   SET0      pdc_mode_control
               #0x011: 0x20   RETURN
               #0x012: 0x00
               #0x013: 0x00
]
