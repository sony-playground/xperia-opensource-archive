[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ScmDxeLA
  FILE_GUID                      = 5E1B0C51-D7AF-455D-B4DF-41F94B7B5749
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = ScmProtocolInit

[BuildOptions.AARCH64]
 GCC:*_*_*_CC_FLAGS = -DSMC_INVOKE_SUPPORT
 GCC:*_*_*_CC_FLAGS = -DSMC_INVOKE_COMPAT_SUPPORT

[Sources.common]
  ScmDxe.c
  ScmArmV7.c
  LogBuffer.c 
  Listener.c

[Sources.Arm]
  ScmArmV8_32.c
  tz_asm_32.S

[Sources.AARCH64]
  ScmArmV8.c
  tz_asm.S
  SmcInvoke/Credential.c
  SmcInvoke/SmcInvoke.c
  SmcInvoke/SmcInvokeCompat.c

[Packages]
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  ArmPkg/ArmPkg.dec
  QcomPkg/QcomPkg.dec
  QcomSdkPkg/QcomSdkPkg.dec

[LibraryClasses]
  BaseLib
  UefiLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  CacheMaintenanceLib
  QcomLib
  QcomBaseLib
  UncachedMemoryAllocationLib
  ArmLib
  PcdLib
  EfiFileLib
  BootConfigLib
  SerialPortLib

[Guids]
  gEfiEventExitBootServicesGuid	         ## CONSUMES
  gEfiEventExitBootServicesSuccessGuid	  ## CONSUMES

[Protocols]
  gQcomScmProtocolGuid            ## PRODUCES
  gEfiShmBridgeProtocolGuid       ## CONSUMES

[Depex]
  gEfiBlockIoProtocolGuid

