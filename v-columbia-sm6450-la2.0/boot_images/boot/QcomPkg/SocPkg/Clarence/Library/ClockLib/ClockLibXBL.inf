[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ClockLib
  FILE_GUID                      = 9FAC2E72-4842-F555-2E0B-59807D44C66F
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = ClockLib

#
#  VALID_ARCHITECTURES           = ARM
#

[BuildOptions.AARCH64]
  #GCC:*_*_*_CC_FLAGS = -O0

[Sources.common]
  ClockApps.c
  ClockAppsBSP.c
  ClockAppsVDD.c
  ClockXBL.c
  ClockCPU.c
  ClockBSP.c
  ClockPropData.c
  ClockImageBIST.c

[LibraryClasses]
  #NpaApiLib
  
[Protocols]
  gEfiNpaProtocolGuid
  gEfiRscHandlerProtocolGuid
  gEfiClockProtocolGuid

[Packages]
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  ArmPkg/ArmPkg.dec
  QcomPkg/SocPkg/SocPkg.dec
  QcomPkg/QcomPkg.dec
  QcomSdkPkg/QcomSdkPkg.dec
  
[FixedPcd]
  gQcomTokenSpaceGuid.PcdLpm
