[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SdccRamDumpTargetLib
  FILE_GUID                      = 1B2395EE-1557-4542-A3FD-E31188A81668
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = SdccTargetLib 

[Sources.common]
  SdccLoaderBspLib.c
  
[BuildOptions.AARCH64]
  GCC:*_*_*_CC_FLAGS = -Wno-unused-function -DSDCC_TARGET_RAMDUMP_IMAGE
  
[BuildOptions.ARM]
  RVCT:*_*_*_CC_FLAGS = --diag_suppress=177 -DSDCC_TARGET_RAMDUMP_IMAGE

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  QcomPkg/QcomPkg.dec
  QcomPkg/SocPkg/SocPkg.dec
  QcomPkg/XBLLoaderApi.dec
  QcomSdkPkg/QcomSdkPkg.dec

[LibraryClasses]
  ArmLib
  CacheMaintenanceLib
  SdccClockLib
  PmicLoaderLib
