{
    "Components": [{
            "Name": "XBL_SC",
            "Binary": "$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/QC_sign/xbl_sc.elf"
        },
        {
            "Name": "TME_FW",
            "Binary": "$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/QC_sign/signed_firmware_soc_view.elf"
        },
        {
            "Name": "TME_SEQ_RAM",
            "Binary": "$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/sequencer_ram.elf"
        },
        {
            "Name": "DevPrg_ddr",
            "Process": [{
                    "ToolChain": "CLANG120",
                    "AArch": "AARCH64",
                    "Params": ["$EDK2ROOT/BaseTools/Source/Python/build/build.py", "-p", "QcomPkg/SocPkg/Netrani/Common/DevprogD.dsc", "--verbose", "-j", "QcomPkg/SocPkg/Netrani/$VAR/build_DevprogD.log", "-w", "-a", "AARCH64", "-b", "$REL"]
                }
            ]
        },
        {
            "Name": "DevPrgS_ddr",
            "Process": [{
                    "ToolChain": "CLANG120",
                    "AArch": "AARCH64",
                    "Params": ["$EDK2ROOT/BaseTools/Source/Python/build/build.py", "-p", "QcomPkg/SocPkg/Netrani/Common/DevprogDS.dsc", "--verbose", "-j", "QcomPkg/SocPkg/Netrani/$VAR/build_DevprogDS.log", "-w", "-a", "AARCH64", "-b", "$REL"]
                }
            ]
        },
        {
            "Name": "DevPrgST_ddr",
            "Process": [{
                    "ToolChain": "CLANG120",
                    "AArch": "AARCH64",
                    "Params": ["$EDK2ROOT/BaseTools/Source/Python/build/build.py", "-p", "QcomPkg/SocPkg/Netrani/Common/DevprogDST.dsc", "--verbose", "-j", "QcomPkg/SocPkg/Netrani/$VAR/build_DevprogDST.log", "-w", "-a", "AARCH64", "-b", "$REL"]
                }
            ]
        },
        {
            "Name": "DTS",
            "Process": [{
                    "ToolChain": "Gendtb",
                    "Createfolders": ["$BUILDROOT/Build/Netrani$VAR/DTC"],
                    "Params": ["-f", "$BOOTROOT/Settings/Netrani/platform-mtp.dts", "-o", "$BUILDROOT/Build/Netrani$VAR/DTC/","-i", "-ISettings/Netrani/Include -ISettings/Include", "-c", "$CLANG120", "-d", "$DTC"]
                },
                {
                    "ToolChain": "Gendtb",
                    "Createfolders": ["$BUILDROOT/Build/Netrani$VAR/DTC"],
                    "Params": ["-f", "$BOOTROOT/Settings/Netrani/pre_ddr-soc.dts", "-o", "$BUILDROOT/Build/Netrani$VAR/DTC/","-i", "-ISettings/Netrani/Include -ISettings/Include", "-c", "$CLANG120", "-d", "$DTC"]
                }
            ]
        }
    ],
    "CreateImages": [
        {
            "Name": "XBL_S_DEVPRG_NS",
            "Process": [{
                    "ToolChain": "GenXBLConfig",
                    "Components": ["DTS"],
                    "Createfolders": ["$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL", "$BUILDROOT/Build/Netrani$VAR/xblconfigdevprg"],
                    "Params": ["-i", "$BOOTROOT/$TARGETROOT/$VAR/create_xbl_config_dev_prg.json",
                        "-b", "$BUILDROOT",
                        "--sectools_directory", "$SECTOOLSROOT",
                        "--tools_path", "$BOOTTOOLS/XBLConfig",
                        "-f", "ELF",
                        "--output-file", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/xbl_config_devprg",
                        "--autogen_directory", "$BUILDROOT/Build/Netrani$VAR/xblconfigdevprg",
                        "--elf-address", "0x1494E000",
                        "--security_profile", "$BUILDROOT/ssg_tmefwrel/profiles/netrani/netrani_tme_security_profile.xml",
                        "--sign_id", "XBL-CONFIG",
                        "--sectools_version", "v2",
                        "--signing_mode", "TEST"]
                }, {
                    "ToolChain": "Copy",
                    "Components": ["DevPrg_ddr"],
                    "Createfolders": ["$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/unsigned"],
                    "Params": ["$BUILDROOT/Build/Netrani$VAR/DevprogD/$REL_$COMPILER/$AARCH/DevPrgD.elf", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/unsigned/prog_firehose_ddr.elf"]
                }, {
                    "ToolChain": "Network_Sign_v2",
                    "Params": [
                        "secure-image", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/unsigned/prog_firehose_ddr.elf",
                        "--outfile", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/prog_firehose_ddr.elf",
                        "--image-id", "DEVICE-PROGRAMMER",
                        "--security-profile", "$BUILDROOT/ssg_tmefwrel/profiles/netrani/netrani_tme_security_profile.xml",
                        "--sign",
                        "--signing-mode", "TEST"]
                }, {
                    "ToolChain": "Create_Melf",
                    "Components": ["XBL_SC", "TME_FW", "TME_SEQ_RAM", "DevPrg_ddr"],
                    "Params": ["-o",
                        "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/prog_firehose_ddr.melf",
                        "-f",
                        "$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/sequencer_ram.elf,$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/QC_sign/signed_firmware_soc_view.elf,$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/QC_sign/xbl_sc.elf,$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/prog_firehose_ddr.elf,$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/xbl_config_devprg.elf"
                        ]
                    }
                ]
        },
        {
            "Name": "XBL_S_DEVPRGS_NS",
            "Process": [{
                    "ToolChain": "GenXBLConfig",
                    "Components": ["DTS"],
                    "Createfolders": ["$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL", "$BUILDROOT/Build/Netrani$VAR/xblconfigdevprg"],
                    "Params": ["-i", "$BOOTROOT/$TARGETROOT/$VAR/create_xbl_config_dev_prg.json",
                        "-b", "$BUILDROOT",
                        "--sectools_directory", "$SECTOOLSROOT",
                        "--tools_path", "$BOOTTOOLS/XBLConfig",
                        "-f", "ELF",
                        "--output-file", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/xbl_config_devprg",
                        "--autogen_directory", "$BUILDROOT/Build/Netrani$VAR/xblconfigdevprg",
                        "--elf-address", "0x1494E000",
                        "--security_profile", "$BUILDROOT/ssg_tmefwrel/profiles/netrani/netrani_tme_security_profile.xml",
                        "--sign_id", "XBL-CONFIG",
                        "--sectools_version", "v2",
                        "--signing_mode", "TEST"]
                }, {
                    "ToolChain": "Copy",
                    "Components": ["DevPrgS_ddr"],
                    "Createfolders": ["$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/unsigned"],
                    "Params": ["$BUILDROOT/Build/Netrani$VAR/DevprogDS/$REL_$COMPILER/$AARCH/DevPrgDS.elf", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/unsigned/prog_firehose_somc_ddr_live.elf"]
                }, {
                    "ToolChain": "Network_Sign_v2",
                    "Params": [
                        "secure-image", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/unsigned/prog_firehose_somc_ddr_live.elf",
                        "--outfile", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/prog_firehose_somc_ddr_live.elf",
                        "--image-id", "DEVICE-PROGRAMMER",
                        "--security-profile", "$BUILDROOT/ssg_tmefwrel/profiles/netrani/netrani_tme_security_profile.xml",
                        "--sign",
                        "--signing-mode", "TEST"]
                }, {
                    "ToolChain": "Create_Melf",
                    "Components": ["XBL_SC", "TME_FW", "TME_SEQ_RAM", "DevPrgS_ddr"],
                    "Params": ["-o",
                        "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/prog_firehose_somc_ddr_live.melf",
                        "-f",
                        "$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/sequencer_ram.elf,$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/QC_sign/signed_firmware_soc_view.elf,$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/QC_sign/xbl_sc.elf,$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/prog_firehose_somc_ddr_live.elf,$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/xbl_config_devprg.elf"
                        ]
                    }
                ]
        },
        {
            "Name": "XBL_S_DEVPRGST_NS",
            "Process": [{
                    "ToolChain": "GenXBLConfig",
                    "Components": ["DTS"],
                    "Createfolders": ["$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL", "$BUILDROOT/Build/Netrani$VAR/xblconfigdevprg"],
                    "Params": ["-i", "$BOOTROOT/$TARGETROOT/$VAR/create_xbl_config_dev_prg.json",
                        "-b", "$BUILDROOT",
                        "--sectools_directory", "$SECTOOLSROOT",
                        "--tools_path", "$BOOTTOOLS/XBLConfig",
                        "-f", "ELF",
                        "--output-file", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/xbl_config_devprg",
                        "--autogen_directory", "$BUILDROOT/Build/Netrani$VAR/xblconfigdevprg",
                        "--elf-address", "0x1494E000",
                        "--security_profile", "$BUILDROOT/ssg_tmefwrel/profiles/netrani/netrani_tme_security_profile.xml",
                        "--sign_id", "XBL-CONFIG",
                        "--sectools_version", "v2",
                        "--signing_mode", "TEST"]
                }, {
                    "ToolChain": "Copy",
                    "Components": ["DevPrgST_ddr"],
                    "Createfolders": ["$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/unsigned"],
                    "Params": ["$BUILDROOT/Build/Netrani$VAR/DevprogDST/$REL_$COMPILER/$AARCH/DevPrgDST.elf", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/unsigned/prog_firehose_somc_ddr_test.elf"]
                }, {
                    "ToolChain": "Network_Sign_v2",
                    "Params": [
                        "secure-image", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/unsigned/prog_firehose_somc_ddr_test.elf",
                        "--outfile", "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/prog_firehose_somc_ddr_test.elf",
                        "--image-id", "DEVICE-PROGRAMMER",
                        "--security-profile", "$BUILDROOT/ssg_tmefwrel/profiles/netrani/netrani_tme_security_profile.xml",
                        "--sign",
                        "--signing-mode", "TEST"]
                }, {
                    "ToolChain": "Create_Melf",
                    "Components": ["XBL_SC", "TME_FW", "TME_SEQ_RAM", "DevPrgST_ddr"],
                    "Params": ["-o",
                        "$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/prog_firehose_somc_ddr_test.melf",
                        "-f",
                        "$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/sequencer_ram.elf,$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/QC_sign/signed_firmware_soc_view.elf,$BOOTROOT/$TARGETROOT/Bin_ext/$VAR/QC_sign/xbl_sc.elf,$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/prog_firehose_somc_ddr_test.elf,$BOOTROOT/$TARGETROOT/Bin/$VAR/$REL/xbl_config_devprg.elf"
                        ]
                    }
                ]
        }
    ]
}