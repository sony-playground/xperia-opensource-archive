  i2c_common_clocks_str_0_handle:i2c_common_clocks_str_0 {
    clocks = "gcc_qupv3_wrap0_core_clk", "gcc_qupv3_wrap0_core_2x_clk",
             "gcc_qupv3_wrap_0_m_ahb_clk", "gcc_qupv3_wrap_0_s_ahb_clk";
  };
  i2c_common_clocks_str_1_handle:i2c_common_clocks_str_1 {
