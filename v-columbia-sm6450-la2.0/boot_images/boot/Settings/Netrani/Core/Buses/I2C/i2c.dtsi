    qupv3_instance              = /bits/ 8 <QUP_0>;
    core_index                  = /bits/ 8 <1>;
    se_index                    = /bits/ 8 <0>;
    gpi_index                   = /bits/ 8 <0>;
    core_irq                    = <0>;
    polled_mode                 = <TRUE>;
    min_data_length_for_dma     = <0>;
    
    scl_encoding                = <TOP_QUP_00_SCL>;
    sda_encoding                = <TOP_QUP_00_SDA>;

