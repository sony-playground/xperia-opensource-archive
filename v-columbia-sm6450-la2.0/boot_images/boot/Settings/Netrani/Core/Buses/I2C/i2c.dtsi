        t_high = /bits/ 8 <10>;
        t_low = /bits/ 8 <11>;
      };
      clock_config_1 {
          se_clock_frequency_khz =<19200>;
          bus_speed_khz = <400>;
          clk_div = /bits/ 8 <2>;
          t_cycle = /bits/ 8 <24>;
          t_high = /bits/ 8 <7>;
          t_low = /bits/ 8 <10>;
      };
      clock_config_2 {
